{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heroesofcode/tate/eval/schema/pages.schema.json",
  "title": "tate eval work",
  "type": "object",
  "additionalProperties": false,
  "required": ["work", "title", "direction", "pages"],
  "properties": {
    "work": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "title": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["rtl", "ltr"] },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "styles", "image", "size", "whole", "ci"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "styles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": [
            "standard", "dense", "borderless", "bleed", "irregular", "diagonal",
            "spread", "splash", "4koma", "old-scan", "low-contrast", "skewed",
            "overlap-border", "balloon-cross", "color", "ltr", "rtl"
          ] }
        },
        "image": { "$ref": "#/$defs/image" },
        "size": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "pixel_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "panels": { "type": "array", "items": { "$ref": "#/$defs/panel" } },
        "whole": { "type": "boolean" },
        "balloons": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "ignore": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "ci": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": { "type": "string" },
            "member": { "type": "string" },
            "pdf_page": { "type": "integer", "minimum": 0 },
            "crop": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["derive"],
          "properties": {
            "derive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "ops"],
              "properties": {
                "from": { "type": "string" },
                "ops": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/op" }
                }
              }
            }
          }
        }
      ]
    },
    "op": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["rotate"], "properties": { "rotate": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["contrast"], "properties": { "contrast": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["gamma"], "properties": { "gamma": { "type": "number", "exclusiveMinimum": 0 } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["noise", "seed"],
          "properties": {
            "noise": { "type": "number", "minimum": 0 },
            "seed": { "type": "integer" }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["jpeg"], "properties": { "jpeg": { "type": "integer", "minimum": 1, "maximum": 95 } } },
        { "type": "object", "additionalProperties": false, "required": ["scale"], "properties": { "scale": { "type": "number", "exclusiveMinimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["yellow"], "properties": { "yellow": { "type": "number", "minimum": 0, "maximum": 1 } } }
      ]
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["box"],
      "properties": {
        "box": { "$ref": "#/$defs/box" },
        "poly": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["box"],
      "properties": { "box": { "$ref": "#/$defs/box" } }
    },
    "box": {
      "type": "array",
      "description": "Half-open pixel box [x1, y1, x2, y2).",
      "prefixItems": [
        { "type": "integer" },
        { "type": "integer" },
        { "type": "integer" },
        { "type": "integer" }
      ],
      "minItems": 4,
      "maxItems": 4
    }
  }
}
